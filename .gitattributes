# 统一换行策略, 保证在 Windows / Linux 上 checkout 后行为一致。
#
# 关键点: shell 脚本必须是 LF —— 若被转成 CRLF, Linux 下
# "#!/bin/bash\r" 会导致 "bad interpreter: No such file or directory"。
*.sh   text eol=lf
*.py   text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.md   text eol=lf

# Windows 批处理必须是 CRLF, 否则 cmd.exe 的 label/goto 可能失效
*.bat  text eol=crlf

# 二进制
*.exe  binary
*.o    binary
*.obj  binary
*.zip  binary
